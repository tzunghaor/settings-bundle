{# the form part of the settings editor #}
{% use "@TzunghaorSettings/editor_blocks.html.twig" %}
<div class="tzunghaor_settings_editor">
    {% block ts_section_heading %}
        <h3>
            {% block ts_section_title %}
                {% set ts_trans_text = 'Section "%section%" for scope "%scope%"' %}
                {% set ts_trans_args = {'%section%': form.vars.label, '%scope%': currentScope.title } %}
                {{ block('ts_cond_trans') }}
            {% endblock %}
        </h3>
    {% endblock %}

    {% block ts_section_description %}
        {{ form_help(form, {help_attr: {class: "tzunghaor_settings_section_description"}}) }}
    {% endblock %}

    {% block ts_form %}
        {{ form_start(form) }}

        {% block ts_form_main %}
            {% for settingName, formField in form['settings'] %}
                {% block ts_setting_form %}
                    <div class="tzunghaor_setting_group">
                        {% block ts_setting_in_scope %}
                            {{ form_row(form['in_scope'][settingName]) }}
                        {% endblock %}

                        <div class="tzunghaor_setting_value">
                            {% block ts_setting_current %}
                                {{ form_row(formField) }}
                            {% endblock %}

                            {% block ts_setting_parent %}
                                {{ form_row(form['parent_settings'][settingName]) }}
                            {% endblock %}
                        </div>
                    </div>
                {% endblock %}
            {% endfor %}
        {% endblock %}

        {% block ts_save_button %}
            <button type="submit">{% set ts_trans_text = 'Save' %}{{ block('ts_cond_trans') }}</button>
        {% endblock %}

        {# button templates must be inside the form in order the javascript to find them #}
        {% block ts_button_templates %}
            <template class="tzunghaor_setting_add_button"><button type="button">{% set ts_trans_text = 'Add' %}{{ block('ts_cond_trans') }}</button></template>
            <template class="tzunghaor_setting_remove_button"><button type="button">X</button></template>
        {% endblock %}

        {{ form_end(form) }}
    {% endblock %}
</div>
